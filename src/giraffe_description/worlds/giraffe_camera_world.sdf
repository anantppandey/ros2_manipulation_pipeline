<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="giraffe_camera_world">
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>
    <model name="red_cube">
      <pose>0.1 0.4 1.03 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.03 0.03 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>0.03 0.03 0.03</size>
            </box>
          </geometry>
        </collision>
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <model name="blue_cube">
      <pose>0.18 0.32 1.03 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.03 0.03 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.25 0.8 1</ambient>
            <diffuse>0.1 0.25 0.8 1</diffuse>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.03 0.03 0.03</size>
            </box>
          </geometry>
        </collision>

        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <model name="yellow_cube">
      <pose>-0.125 0.41 1.03 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <box>
              <size>0.03 0.03 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.85 0.72 0.18 1</ambient>
            <diffuse>0.85 0.72 0.18 1</diffuse>
          </material>
        </visual>

        <collision name="collision">
          <geometry>
            <box>
              <size>0.03 0.03 0.03</size>
            </box>
          </geometry>
        </collision>

        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.001</ixx>
            <iyy>0.001</iyy>
            <izz>0.001</izz>
          </inertia>
        </inertial>
      </link>
    </model>

    <model name="collection_box">
      <static>true</static>

      <pose>-0.15 0.3 1.015 0 0 0</pose>

      <link name="box">

        <!-- Bottom -->
        <collision name="bottom_collision">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <box>
              <size>0.09 0.09 0.01</size>
            </box>
          </geometry>
        </collision>

        <visual name="bottom_visual">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry>
            <box>
              <size>0.09 0.09 0.01</size>
            </box>
          </geometry>
        </visual>

        <!-- X marker -->
        <visual name="x_mark_1">
          <pose>0 0 0.0105 0 0 0.785398</pose>
          <geometry>
            <box>
              <size>0.06 0.004 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <visual name="x_mark_2">
          <pose>0 0 0.0105 0 0 -0.785398</pose>
          <geometry>
            <box>
              <size>0.06 0.004 0.001</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
          </material>
        </visual>

        <!-- Left wall -->
        <collision name="left_collision">
          <pose>0 0.04 0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>0.09 0.01 0.06</size>
            </box>
          </geometry>
        </collision>

        <visual name="left_visual">
          <pose>0 0.04 0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>0.09 0.01 0.06</size>
            </box>
          </geometry>
        </visual>

        <!-- Right wall -->
        <collision name="right_collision">
          <pose>0 -0.04 0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>0.09 0.01 0.06</size>
            </box>
          </geometry>
        </collision>

        <visual name="right_visual">
          <pose>0 -0.04 0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>0.09 0.01 0.06</size>
            </box>
          </geometry>
        </visual>

        <!-- Front wall -->
        <collision name="front_collision">
          <pose>0.04 0 0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.07 0.06</size>
            </box>
          </geometry>
        </collision>

        <visual name="front_visual">
          <pose>0.04 0 0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.07 0.06</size>
            </box>
          </geometry>
        </visual>

        <!-- Back wall -->
        <collision name="back_collision">
          <pose>-0.04 0 0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.07 0.06</size>
            </box>
          </geometry>
        </collision>

        <visual name="back_visual">
          <pose>-0.04 0 0.03 0 0 0</pose>
          <geometry>
            <box>
              <size>0.01 0.07 0.06</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>

    <model name="static_obstacle_1">
      <static>true</static>
      <pose>-0.05 0.375 1.07 0 0 0.0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.015 0.2 0.11</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.015 0.2 0.11</size></box>
          </geometry>
          <!-- <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material> -->
        </visual>
      </link>
    </model>

